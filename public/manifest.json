{
  "name": "PDF Suite - Document & PDF Converter",
  "short_name": "PDF Suite",
  "description": "All-in-one Android PDF and document converter. Convert Word, images, sheets, and text to PDF, merge, compress, split, and AI OCR scan.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#dc2626",
  "categories": ["productivity", "utilities", "business"],
  "dir": "ltr",
  "lang": "en-US",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Merge PDFs",
      "short_name": "Merge",
      "description": "Combine multiple PDFs into one document",
      "url": "/?tool=merge",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Compress PDF",
      "short_name": "Compress",
      "description": "Reduce PDF file size up to 70%",
      "url": "/?tool=compress",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Scan Document",
      "short_name": "Scan",
      "description": "Camera scan to PDF",
      "url": "/?tool=img-to-pdf&source=camera",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI OCR Scanner",
      "short_name": "AI OCR",
      "description": "Extract text with Gemini AI",
      "url": "/?tool=ai-ocr",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "PDF & Document Converter",
      "accept": {
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"],
        "text/plain": [".txt", ".md"],
        "text/csv": [".csv"]
      }
    }
  ],
  "share_target": {
    "action": "/?source=share_target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "shared_files",
          "accept": ["application/pdf", "image/*", "text/*", ".docx", ".csv"]
        }
      ]
    }
  },
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.pdfsuite.converter",
      "id": "com.pdfsuite.converter"
    }
  ]
}
